[Unit]
Description=Neeman Music Agent
After=network-online.target sound.target soundops-firstboot.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/music_agent
Environment=PYTHONUNBUFFERED=1
Environment=SYSTEM_SINK_VOLUME=90
Environment=AUDIO_PREFER=auto
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/home/pi/.deno/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/bash /home/pi/music_agent/scripts/set-system-volume.sh
ExecStart=/home/pi/music_agent/.venv/bin/python3 /home/pi/music_agent/main.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
